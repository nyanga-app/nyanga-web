---
// Lines to paste into a terminal, with a Copy button that copies all of them.
interface Props {
  code: string;
  label?: string; // which terminal, e.g. "PowerShell"
}

const { code, label } = Astro.props;
---

<div class="cmd">
  <div class="cmd-bar">
    <span>{label ?? "Terminal"}</span>
    <button type="button" class="copy" data-copy={code}>Copy</button>
  </div>
  <pre><code>{code}</code></pre>
</div>

<script>
  // One listener for every block on the page. The clipboard API needs https; nyanga.page has it,
  // the selection fallback covers anything else.
  async function copy(text: string, from: HTMLElement): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const code = from.closest(".cmd")?.querySelector("code");
      if (!code) return false;
      const range = document.createRange();
      range.selectNodeContents(code);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
      return document.execCommand("copy");
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".cmd .copy")) {
    button.addEventListener("click", async () => {
      const ok = await copy(button.dataset.copy ?? "", button);
      button.textContent = ok ? "Copied ✦" : "Select and copy";
      button.classList.toggle("done", ok);
      setTimeout(() => {
        button.textContent = "Copy";
        button.classList.remove("done");
      }, 1800);
    });
  }
</script>

<style>
  .cmd { margin: 12px 0 4px; border-radius: 16px; overflow: hidden; border: 1px solid var(--border); background: var(--card); }
  .cmd-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 6px 8px 6px 14px; background: var(--chip); color: var(--accent-soft); font-size: 13px; font-weight: 600; }
  .copy { font: inherit; font-size: 13px; font-weight: 600; padding: 5px 12px; border: 0; border-radius: 999px; background: var(--card); color: var(--accent); cursor: pointer; }
  .copy:hover { color: var(--accent-soft); }
  .copy:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .copy.done { background: linear-gradient(90deg, var(--primary-a), var(--primary-b)); color: #fff; }
  pre { margin: 0; padding: 12px 16px; overflow-x: auto; font-size: 14.5px; line-height: 1.6; color: var(--text); }
  code { font-family: ui-monospace, "Cascadia Mono", "JetBrains Mono", Menlo, Consolas, monospace; white-space: pre; }
</style>
