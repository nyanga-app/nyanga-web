---
import { RELEASES_PAGE, formatSize, latest } from "../lib/releases";

const release = await latest();
---

<div class="download">
  <a class="button" href={release?.url ?? RELEASES_PAGE}>
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path>
    </svg>
    Download for Windows ♡
  </a>
  <p class="meta">
    {release ? <>Version {release.version} · {formatSize(release.size)} · free</> : <>Free · Windows 10 and 11</>}
  </p>
</div>

<style>
  .download { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .meta { margin: 0; color: var(--muted); font-size: 15px; }
</style>
