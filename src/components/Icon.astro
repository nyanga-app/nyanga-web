---
// One of the app's own icons (src/lib/icons.ts), in the current text color.
import { ICONS } from "../lib/icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[name]} />
