---
import "../styles/global.css";
import { REPO } from "../lib/releases";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nyanga: a cozy manga downloader for Windows and Linux (CBZ, PDF, EPUB)",
  description = "Nyanga is a free Windows and Linux app that downloads manga and saves one tidy file per volume as CBZ, PDF, EPUB or image folders. Search by name, pick chapters, and it updates itself.",
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const card = new URL("/img/card.png", Astro.site);
// Kept out of search results until the site has its own domain; switching `site` in
// astro.config.mjs to that domain lets search engines in.
const indexed = !Astro.site?.hostname.endsWith(".workers.dev");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexed && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ff7eb3" />

    <!-- link previews (Discord, WhatsApp, X…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nyanga" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Nyanga cat reading a book next to the app" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Fredoka-600.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Linux visitors get the AppImage as the main download (DownloadButton.astro). Set before
      // anything is drawn, so the button doesn't switch while you look at it.
      if (/Linux/.test(navigator.userAgent) && !/Android|CrOS/.test(navigator.userAgent)) document.documentElement.dataset.os = "linux";
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/">
          <img src="/img/icon.svg" width="38" height="38" alt="" />
          <span>Nyanga</span>
        </a>
        <nav>
          <a href="/#features">Features</a>
          <a href="/install/" aria-current={path.startsWith("/install") ? "page" : undefined}>Install</a>
          <a href="/changelog/" aria-current={path.startsWith("/changelog") ? "page" : undefined}>What's new</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <img src="/img/icon.svg" width="44" height="44" alt="" />
        <p>Made with a lot of cat naps.</p>
        <p class="small">
          <a href="/changelog/">What's new</a> · <a href={`https://github.com/${REPO}`}>Source on GitHub</a>{" · "}
          <a href={`https://github.com/${REPO}/issues`}>Report a problem</a>
        </p>
        <p class="small muted">
          Nyanga isn't affiliated with any manga site. Please support the creators of the manga you love ✿
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-size: 22px; font-weight: 700; color: var(--accent); }
  nav { display: flex; gap: 4px; }
  nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 999px;
  }
  nav a:hover, nav a[aria-current="page"] { background: var(--chip); color: var(--accent); }
  @media (max-width: 560px) {
    nav a[href="/#features"] { display: none; }
    nav a { padding: 6px 9px; font-size: 15px; }
    .brand span { display: none; }
  }

  .foot { margin-top: 96px; padding: 40px 0 48px; border-top: 1px solid var(--border); background: var(--bg-soft); text-align: center; }
  .foot p { margin: 6px 0; }
  .small { font-size: 15px; }
  .muted { color: var(--muted); }
</style>
