---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Themed from "../components/Themed.astro";
import { history } from "../lib/releases";
import { releasesHtml } from "../lib/render";

const releases = await history();
---

<Base title="What's new in Nyanga" description="Every Nyanga update, in plain words.">
  <section class="head">
    <div class="wrap">
      <Themed name="/img/cat-happy" width={150} height={120} />
      <h1>What's new ✧</h1>
      <p>Every update so far, newest first. The app updates itself, so you always get these.</p>
    </div>
  </section>

  <div class="wrap list">
    {releases.length > 0 ? (
      <div id="notes" set:html={releasesHtml(releases)} />
    ) : (
      <div id="notes" data-fetch>
        <p class="waiting">Fetching the notes…</p>
      </div>
    )}
    <div class="again"><DownloadButton /></div>
  </div>
</Base>

<script>
  // The build couldn't reach GitHub, so fetch the notes here instead.
  import { API, RELEASES_PAGE, fromGitHub, type GhRelease } from "../lib/notes";
  import { releasesHtml } from "../lib/render";

  const box = document.querySelector<HTMLElement>("#notes[data-fetch]");
  if (box) {
    fetch(API, { headers: { Accept: "application/vnd.github+json" } })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((all: GhRelease[]) => {
        const releases = fromGitHub(all);
        if (!releases.length) throw new Error("no notes");
        box.innerHTML = releasesHtml(releases);
      })
      .catch(() => {
        box.innerHTML = `<p class="waiting">The notes couldn't be loaded right now. They're also on the <a href="${RELEASES_PAGE}">releases page</a> ♡</p>`;
      });
  }
</script>

<style>
  .head { text-align: center; padding: 40px 0 12px; }
  .head h1 { font-size: clamp(36px, 7vw, 52px); color: var(--accent); }
  .head p { color: var(--muted); margin: 6px auto 0; max-width: 520px; }
  .list { max-width: 760px; }
  .again { margin-top: 56px; }

  /* :global because the browser fallback adds this markup after the page loads */
  #notes :global(.release) { margin-top: 44px; }
  #notes :global(.release header) { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 12px; padding-bottom: 8px; border-bottom: 2px dashed var(--border); }
  #notes :global(.release h2) { font-size: 26px; text-align: left; }
  #notes :global(.release time) { color: var(--muted); font-size: 15px; margin-left: auto; }
  #notes :global(.latest) { background: linear-gradient(90deg, var(--primary-a), var(--primary-b)); color: #fff; font-weight: 600; }
  #notes :global(h3) { font-size: 17px; color: var(--accent); margin: 20px 0 8px; }
  #notes :global(ul) { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  #notes :global(.note) { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 12px 16px; }
  #notes :global(.note-title) { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; font-weight: 600; }
  #notes :global(.note p) { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
  #notes :global(.waiting) { text-align: center; color: var(--muted); margin-top: 40px; }
</style>
