---
import Docs from "../../layouts/Docs.astro";
import Icon from "../../components/Icon.astro";
import Themed from "../../components/Themed.astro";
import { formatSize, latest } from "../../lib/releases";

const release = await latest();
const ways = [
  {
    os: "windows",
    href: "/install/windows/",
    icon: "download",
    title: "Windows",
    text: "An installer for Windows 10 and 11. No admin password, and it updates itself.",
    meta: release ? `Version ${release.version} · ${formatSize(release.size)}` : "",
  },
  {
    os: "linux",
    href: "/install/linux/",
    icon: "download",
    title: "Linux",
    text: "One AppImage file that runs on most Linux systems. Nothing to install, and it updates itself.",
    meta: release?.linux ? `Version ${release.version} · ${formatSize(release.linux.size)}` : "",
  },
  {
    os: "source",
    href: "/install/source/",
    icon: "settings",
    title: "From the source code",
    text: "Run it straight from the code with Python, on Windows, Linux or (probably) a Mac. You update it yourself.",
    meta: "For the curious, or if you'd like to help",
  },
];
---

<Docs
  title="Installing Nyanga: the install guide"
  description="How to install Nyanga, the cozy manga downloader, on Windows or Linux, or run it from the source code. Step by step, with commands you can copy."
  heading="Installing Nyanga ✦"
  lead="Pick your computer and follow along. It takes a few minutes, and you only do it once: after that Nyanga updates itself."
>
  <div class="ways">
    {ways.map((w) => (
      <a class:list={["way", w.os]} href={w.href}>
        <span class="badge"><Icon name={w.icon} size={22} /></span>
        <span class="words">
          <b>{w.title}</b>
          <span>{w.text}</span>
          {w.meta && <small>{w.meta}</small>}
        </span>
        <span class="go">→</span>
      </a>
    ))}
  </div>
  <div class="cat"><Themed name="/img/cat-reading" width={120} height={96} /></div>
  <p class="help">Stuck somewhere? <a href="https://github.com/nyanga-app/nyanga-app/issues">Tell me about it</a> and I'll help.</p>
</Docs>

<style>
  /* Linux visitors (marked by Base.astro) get the Linux card first. */
  .ways { display: flex; flex-direction: column; gap: 14px; margin-top: 30px; }
  :global(:root[data-os="linux"]) .way.linux { order: -1; }
  .way { display: flex; align-items: center; gap: 16px; padding: 18px 20px; border-radius: 20px; background: var(--card); border: 1px solid var(--border); color: inherit; text-decoration: none; transition: box-shadow 0.15s ease, transform 0.15s ease; }
  .way:hover { box-shadow: var(--shadow); transform: translateY(-2px); color: inherit; }
  .badge { flex: none; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 16px; background: var(--chip); color: var(--accent); }
  .words { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .words b { font-size: 19px; color: var(--text); }
  .words span { color: var(--muted); }
  .words small { color: var(--accent-soft); font-size: 14px; margin-top: 2px; }
  .go { flex: none; color: var(--accent); font-size: 22px; font-weight: 600; }
  .cat { display: flex; justify-content: center; margin-top: 36px; }
  .help { text-align: center; margin: 6px 0 0; }
  @media (prefers-reduced-motion: reduce) { .way { transition: none; } .way:hover { transform: none; } }
</style>
