// Cloudflare deploys the built site (dist/) as static files; unknown pages get our 404 page.
// worker.js runs first so the old workers.dev address redirects to nyanga.page.
{
  "name": "nyanga-web",
  "compatibility_date": "2026-10-01",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
